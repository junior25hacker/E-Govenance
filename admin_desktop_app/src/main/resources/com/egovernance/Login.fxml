<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.egovernance.LoginController" styleClass="root">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <VBox alignment="CENTER" spacing="20.0" styleClass="glass-panel" maxWidth="400.0">
         <Label styleClass="title-label" text="Emergence Connect" />
         <Label styleClass="subtitle-label" text="Secure Identity Gateway" />
         <TextField fx:id="usernameField" maxWidth="300.0" promptText="Admin Username" styleClass="text-field" />
         <PasswordField fx:id="passwordField" maxWidth="300.0" promptText="Password" styleClass="password-field" />
         <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-primary" text="Authenticate Identity" prefWidth="300.0"/>
         <Label fx:id="statusLabel" style="-fx-text-fill: #ff4d4d;" />
      </VBox>
   </children>
</VBox>
