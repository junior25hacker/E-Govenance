# ──────────────────────────────────────────────
# CitizenNode E-Governance Backend Configuration
# ──────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=citizennode-secure-jwt-secret-key-2026
JWT_EXPIRY=1d

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# SQLite Database
DB_PATH=./database.sqlite
