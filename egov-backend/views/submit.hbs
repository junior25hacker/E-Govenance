<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document Submission | Emergence-Connect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <style>
    :root {
      --navy: #050d1f;
      --navy-2: #0a1833;
      --gold: #c9a84c;
      --gold-dim: #7a5f20;
      --cream: #f2eedf;
      --cream-dim: #cdc8b4;
      --white: #ffffff;
      --glass: rgba(255,255,255,0.06);
      --border: rgba(201,168,76,0.18);
      --radius: 20px;
      --radius-sm: 12px;
    }
    *,*::before,*::after{box-sizing:border-box;}
    html{scroll-behavior:smooth;}
    body{margin:0;min-height:100vh;font-family:'DM Sans',sans-serif;background:radial-gradient(circle at top left,rgba(37,99,176,0.22),transparent 26%),radial-gradient(circle at bottom right,rgba(201,168,76,0.15),transparent 24%),var(--navy);color:var(--cream);}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");opacity:0.3;}
    img{max-width:100%;display:block;}
    a{color:inherit;text-decoration:none;}
    .container{width:min(1120px,calc(100% - 40px));margin:0 auto;}
    .site-shell{min-height:100vh;display:flex;flex-direction:column;justify-content:center;gap:24px;padding:32px 0 48px;}
    .masthead{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:20px 0;}
    .brand{font-family:'Cinzel',serif;font-size:1.25rem;font-weight:700;letter-spacing:0.08em;color:var(--gold);}
    .page-card{background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:var(--radius);padding:32px;backdrop-filter:blur(16px);box-shadow:0 24px 50px rgba(0,0,0,0.28);}
    .page-title{font-family:'Cinzel',serif;font-size:clamp(2rem,3.5vw,2.6rem);margin-bottom:12px;}
    .page-subtitle{color:var(--cream-dim);margin-bottom:28px;line-height:1.7;}
    .button,.button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:12px 22px;border-radius:999px;border:1px solid transparent;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease,background .2s ease;}
    .button{background:linear-gradient(135deg,var(--gold-dim),var(--gold));color:var(--navy);}
    .button-secondary{background:rgba(255,255,255,0.08);border-color:var(--border);color:var(--cream);}
    .button:hover,.button-secondary:hover{transform:translateY(-1px);}
    .help-card{background:rgba(255,255,255,0.06);border:1px solid var(--border);border-radius:var(--radius-sm);padding:24px;}
    .help-card h3{margin:0 0 12px;font-size:1rem;}
    .help-card p{color:var(--cream-dim);line-height:1.65;}
    .page-note{color:rgba(242,238,223,0.72);margin-top:12px;}
    .footer-strip{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;color:rgba(242,238,223,0.72);}
    .form-group { margin-bottom: 20px; text-align: left; }
    .form-group label { display: block; margin-bottom: 8px; font-weight: 500; color: var(--cream); font-size: 0.95rem; }
    .form-input { width: 100%; padding: 14px 16px; background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--white); font-family: 'DM Sans', sans-serif; font-size: 1rem; transition: border-color 0.2s; outline: none; }
    .form-input:focus { border-color: var(--gold); background: rgba(255,255,255,0.07); }
    @media(max-width:800px){.masthead{flex-direction:column;align-items:flex-start;}.page-card{padding:24px;}}
  </style>
</head>
<body>
  <div class="container site-shell">
    <header class="masthead">
      <a class="brand" href="/index">Emergence-Connect</a>
      <div>
        <a class="button button-secondary" href="/civil-status">Back to Gateway</a>
        <a class="button" href="/help">Help</a>
      </div>
    </header>

    <main class="page-card">
      <h1 class="page-title" id="request-name">Document Request</h1>
      <p class="page-subtitle" id="request-detail">Preparing your document request details.</p>

      <form id="submission-form" class="submit-form">
        <input type="hidden" id="document-type" name="documentType" value="general">
        
        <div class="form-group">
          <label for="fullName">Full Name</label>
          <input type="text" id="fullName" name="fullName" required placeholder="John Doe" class="form-input">
        </div>
        
        <div class="form-group">
          <label for="nationalId">National ID Number</label>
          <input type="text" id="nationalId" name="nationalId" required placeholder="NID-XXXX-XXXX" class="form-input">
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required placeholder="john@example.com" class="form-input">
        </div>

        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="text" id="phone" name="phone" required placeholder="+123456789" class="form-input">
        </div>
        
        <div class="form-group">
          <label for="purpose">Purpose of Request</label>
          <textarea id="purpose" name="purpose" rows="3" required placeholder="State the reason for this document request..." class="form-input"></textarea>
        </div>

        <button type="submit" class="button" id="submit-btn" style="width: 100%; margin-top: 10px;">Submit Application</button>
        <div id="form-message" style="margin-top: 16px; display: none; padding: 12px; border-radius: 8px;"></div>
      </form>
    </main>

    <footer class="footer-strip">
      <a href="/login">Login</a>
      <a href="/help">Help</a>
      <a href="/index">Home</a>
    </footer>
  </div>
  <script>
    function getQueryParam(name) {
      const params = new URLSearchParams(window.location.search);
      return params.get(name);
    }

    function showSubmitRequest() {
      const type = getQueryParam('type') || 'general';
      const titles = {
        'birth-cert': 'Birth Certificate',
        'origin-cert': 'Certificate of Origin',
        'residence': 'Residence Permit',
        'legal-attest': 'Legal Attestation',
      };
      const requestType = titles[type] || 'General Document Request';
      const titleEl = document.getElementById('request-name');
      const detailEl = document.getElementById('request-detail');
      const docTypeInput = document.getElementById('document-type');

      if (titleEl) titleEl.textContent = requestType;
      if (docTypeInput) docTypeInput.value = requestType;
      if (detailEl) detailEl.textContent = `You are preparing a ${requestType}. Complete the form below to continue with your application.`;
    }

    window.addEventListener('DOMContentLoaded', showSubmitRequest);

    document.getElementById('submission-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('submit-btn');
      const msg = document.getElementById('form-message');
      btn.disabled = true;
      btn.textContent = 'Submitting...';
      msg.style.display = 'none';

      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/v1/documents/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();
        msg.style.display = 'block';

        if (res.ok && result.status === 'success') {
          msg.style.backgroundColor = 'rgba(46, 204, 113, 0.2)';
          msg.style.color = '#2ecc71';
          msg.style.border = '1px solid rgba(46, 204, 113, 0.4)';
          msg.textContent = 'Success! Your document request was submitted. Redirecting to Dashboard...';
          setTimeout(() => window.location.href = '/dashboard', 2000);
        } else {
          msg.style.backgroundColor = 'rgba(231, 76, 60, 0.2)';
          msg.style.color = '#e74c3c';
          msg.style.border = '1px solid rgba(231, 76, 60, 0.4)';
          msg.textContent = result.message || 'Submission failed. Please check your inputs.';
          btn.disabled = false;
          btn.textContent = 'Submit Application';
        }
      } catch (err) {
        msg.style.display = 'block';
        msg.style.backgroundColor = 'rgba(231, 76, 60, 0.2)';
        msg.style.color = '#e74c3c';
        msg.style.border = '1px solid rgba(231, 76, 60, 0.4)';
        msg.textContent = 'A network error occurred. Please try again.';
        btn.disabled = false;
        btn.textContent = 'Submit Application';
      }
    });
  </script>
</body>
</html>
