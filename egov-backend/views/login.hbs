    <div class="hero-body">
      <div class="hero-version">
        <div class="version-dot"></div>v2.1 · System Online
      </div>
      <h1 class="hero-tagline">Your Documents.<br><span>Secured. Digital.</span><br>Always Accessible.</h1>
      <p class="hero-sub">A unified platform for citizens to manage, verify, and share government-issued documents — all
        from one secure dashboard.</p>
      <div class="hero-features">
        <div class="hero-feature">
          <div class="feature-dot"><span class="material-symbols-outlined">verified_user</span></div>
          <div class="feature-text">
            <div class="feature-title">Biometric Verification</div>
            <div class="feature-desc">Military-grade identity confirmation</div>
          </div>
        </div>
        <div class="hero-feature">
          <div class="feature-dot"><span class="material-symbols-outlined">wallet</span></div>
          <div class="feature-text">
            <div class="feature-title">Digital Document Wallet</div>
            <div class="feature-desc">All your certificates in one place</div>
          </div>
        </div>
        <div class="hero-feature">
          <div class="feature-dot"><span class="material-symbols-outlined">lock</span></div>
          <div class="feature-text">
            <div class="feature-title">256-bit Encrypted</div>
            <div class="feature-desc">GDPR & national data protection compliant</div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-stats">
      <div class="hero-stat">
        <div class="hero-stat-val">2.4M+</div>
        <div class="hero-stat-lbl">Citizens</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-val">99.9%</div>
        <div class="hero-stat-lbl">Uptime</div>
      </div>
