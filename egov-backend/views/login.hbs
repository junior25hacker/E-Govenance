      </div>
    </div>
  </div>

  <div class="form-panel" id="phase-signup">
    <div class="auth-card">
      <div class="auth-card-inner">

        <div class="step-track">
          <div class="step-node active" id="step1-node">1</div>
          <div class="step-line" id="step-line"></div>
          <div class="step-node" id="step2-node">2</div>
        </div>
        <div class="step-labels">
          <div class="step-label active" id="step1-lbl">Create Account</div>
          <div class="step-label" id="step2-lbl">Verify Identity</div>
        </div>

        <div class="form-heading">Create your account</div>
        <p class="form-sub">Secure access to your government digital documents.</p>

        <form id="signup-form" novalidate>
          <div class="form-group">
            <label for="email">Email Address</label>
            <div class="input-wrap">
              <span class="material-symbols-outlined input-icon">mail_outline</span>
              <input type="email" id="email" placeholder="you@example.com" autocomplete="email" required />
            </div>
            <div class="field-error" id="err-email">Please enter a valid email address.</div>
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-wrap">
              <span class="material-symbols-outlined input-icon">lock_outline</span>
              <input type="password" id="password" placeholder="Min. 8 characters" autocomplete="new-password"
                required />
              <button type="button" class="pw-toggle" onclick="toggleVis('password',this)"><span
                  class="material-symbols-outlined" style="font-size:17px">visibility_off</span></button>
            </div>
            <div class="pw-strength">
              <div class="pw-bar" id="pw-b1"></div>
              <div class="pw-bar" id="pw-b2"></div>
              <div class="pw-bar" id="pw-b3"></div>
              <div class="pw-bar" id="pw-b4"></div><span class="pw-label" id="pw-label"></span>
            </div>
            <div class="field-error" id="err-pw">Password must be at least 8 characters.</div>
          </div>
          <div class="form-group">
            <label for="confirm">Confirm Password</label>
            <div class="input-wrap">
              <span class="material-symbols-outlined input-icon">lock_outline</span>
              <input type="password" id="confirm" placeholder="Repeat password" autocomplete="new-password" required />
              <button type="button" class="pw-toggle" onclick="toggleVis('confirm',this)"><span
                  class="material-symbols-outlined" style="font-size:17px">visibility_off</span></button>
            </div>
            <div class="field-error" id="err-confirm">Passwords do not match.</div>
          </div>
          <div class="terms-row">
            <input type="checkbox" id="terms" />
            <label for="terms">I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy
                Policy</a>.</label>
          </div>
          <div class="field-error" id="err-terms" style="margin-top:-8px;margin-bottom:10px">You must accept the terms
            to continue.</div>
          <button type="submit" class="btn-primary" id="signup-btn">
            <span class="spinner" id="signup-spinner"></span>
            <span class="material-symbols-outlined" id="signup-icon" style="font-size:17px">arrow_forward</span>
            <span id="signup-text">Create Account & Continue</span>
          </button>
        </form>

        <form id="signin-form" novalidate style="display: none;">
          <div class="form-group">
            <label for="login-id">Citizen Identification Number</label>
            <div class="input-wrap">
              <span class="material-symbols-outlined input-icon">badge</span>
              <input type="text" id="login-id" placeholder="e.g. CITIZEN-9921" required />
            </div>
          </div>
          <div class="form-group">
            <label for="login-password">Password</label>
            <div class="input-wrap">
              <span class="material-symbols-outlined input-icon">lock_outline</span>
              <input type="password" id="login-password" placeholder="••••••••" required />
              <button type="button" class="pw-toggle" onclick="toggleVis('login-password',this)"><span
                  class="material-symbols-outlined" style="font-size:17px">visibility_off</span></button>
            </div>
          </div>
          <div class="field-error" id="err-login" style="margin-bottom:10px">Invalid credentials. Please try again.
          </div>
          <button type="submit" class="btn-primary" id="signin-btn">
            <span class="spinner" id="signin-spinner"></span>
            <span class="material-symbols-outlined" id="signin-icon" style="font-size:17px">login</span>
            <span id="signin-text">Authenticate & Enter Portal</span>
          </button>
        </form>

        <div class="divider">Authentication</div>

        <button class="btn-ghost" onclick="toggleAuthMode(event)" id="toggle-auth-btn">
          <span class="material-symbols-outlined" style="font-size:17px">login</span>
          <span id="toggle-auth-text">Already a member? Sign In</span>
        </button>

        <div class="footer-links"><a href="/">← Home</a> &nbsp;·&nbsp; <a href="/help">Help</a></div>

      </div>
    </div>
  </div>

  <div id="phase-dashboard">
    <div class="dash-shell">
      <nav class="dash-sidebar">
        <div class="dash-brand">CitizenNode</div>
        <div class="dash-nav-item active"><span class="material-symbols-outlined">dashboard</span> Dashboard</div>
        <div class="dash-nav-item"><span class="material-symbols-outlined">description</span> My Documents</div>
        <div class="dash-nav-item"><span class="material-symbols-outlined">add_task</span> Request Certificate</div>
        <div class="dash-nav-item"><span class="material-symbols-outlined">settings</span> Settings</div>
      </nav>
      <main class="dash-main">
        <div class="dash-main-title">Welcome to your Dashboard</div>
        <div class="dash-kpi-row">
          <div class="dash-kpi">
            <div class="dash-kpi-val">0</div>
            <div class="dash-kpi-lbl">Active Documents</div>
          </div>
          <div class="dash-kpi">
            <div class="dash-kpi-val">0</div>
            <div class="dash-kpi-lbl">Pending Requests</div>
          </div>
          <div class="dash-kpi">
            <div class="dash-kpi-val">0%</div>
            <div class="dash-kpi-lbl">Profile Complete</div>
          </div>
          <div class="dash-kpi">
            <div class="dash-kpi-val">—</div>
            <div class="dash-kpi-lbl">Security Score</div>
          </div>
        </div>
        <div class="dash-section"></div>
      </main>
    </div>
  </div>

  <div id="verification-modal" role="dialog" aria-modal="true">
    <div class="modal-overlay"></div>
    <div class="modal-card">
      <div id="modal-form-state">
        <div class="modal-alert-header">
          <div class="modal-alert-icon"><span class="material-symbols-outlined">warning_amber</span></div>
          <div>
            <div class="modal-alert-sub">Action Required</div>
            <div class="modal-alert-heading">Complete your profile to unlock full services</div>
          </div>
        </div>
        <p class="modal-desc">Your account has been created. <strong>Your Citizen ID is <span id="display-citizen-id"
              style="color:var(--gold); border: 1px solid var(--gold); padding: 2px 6px; border-radius: 4px;">...</span></strong>.
          Please save this! To access your <strong>digital document wallet</strong>, verify your identity by uploading a
          government-issued document. <strong>One-time process.</strong></p>
        <form id="verify-form" novalidate>
          <div class="form-group">
            <label for="doc-type">Document Type</label>
            <div class="input-wrap">
              <span class="material-symbols-outlined input-icon">article</span>
              <select id="doc-type" required>
                <option value="" disabled selected>— Select document type —</option>
                <option value="national_id">National Identity Card</option>
                <option value="birth_cert">Birth Certificate</option>
                <option value="passport">International Passport</option>
                <option value="drivers_lic">Driver's Licence</option>
              </select>
            </div>
            <div class="field-error" id="err-doc-type">Please select a document type.</div>
          </div>
          <div class="form-group">
            <label>Upload Document</label>
            <div class="upload-zone" id="upload-zone">
              <input type="file" id="doc-file" accept=".jpg,.jpeg,.png,.pdf" />
              <div class="upload-zone-icon"><span class="material-symbols-outlined">upload_file</span></div>
              <div class="upload-zone-label">Drag & drop or click to upload</div>
              <div class="upload-zone-hint">JPG, PNG, PDF &nbsp;·&nbsp; <span>Max 10 MB</span></div>
            </div>
            <div class="file-chosen" id="file-chosen"><span class="material-symbols-outlined">check_circle</span><span
                id="file-name-display"></span></div>
            <div class="field-error" id="err-file">Please upload your document.</div>
          </div>
          <button type="submit" class="btn-primary" id="verify-btn" style="margin-top:6px">
            <span class="spinner modal-spinner" id="verify-spinner"></span>
            <span class="material-symbols-outlined" id="verify-icon" style="font-size:17px">verified_user</span>
            <span id="verify-text">Submit for Verification</span>
          </button>
          <button type="button" class="btn-ghost" id="skip-btn" onclick="skipVerification()"
            style="margin-top:12px; border:none;">
            <span id="skip-text">Verify Later</span>
          </button>
        </form>
        <div class="trust-row">
          <div class="trust-badge"><span class="material-symbols-outlined">lock</span>256-bit Encrypted</div>
          <div class="trust-badge"><span class="material-symbols-outlined">shield</span>GDPR Compliant</div>
          <div class="trust-badge"><span class="material-symbols-outlined">verified</span>Govt. Certified</div>
        </div>
      </div>
      <div id="modal-success">
        <div class="success-ring"><span class="material-symbols-outlined">check</span></div>
        <h3>Verification Submitted!</h3>
        <p>Your documents are under review. You'll hear back within <strong style="color:var(--gold)">24–48
            hours</strong>.</p>
        <button class="btn-primary" onclick="enterDashboard()" style="margin-top:24px">
          <span class="material-symbols-outlined" style="font-size:17px">dashboard</span> Go to Dashboard
        </button>
      </div>
    </div>
  </div>

  <script>
    const $ = id => document.getElementById(id);
    function showErr(id, show) { $(`err-${id}`).classList.toggle('show', show); }
    function setErr(id, v) { const e = $(id); if (e) e.classList.toggle('error', v); }
    function toggleVis(id, btn) {
      const inp = $(id); const icon = btn.querySelector('.material-symbols-outlined');
      inp.type = inp.type === 'password' ? 'text' : 'password';
      icon.textContent = inp.type === 'password' ? 'visibility_off' : 'visibility';
    }

    $('password').addEventListener('input', function () {
      const v = this.value, PAL = ['', '#ef4444', '#f59e0b', '#3b82f6', '#22c55e'], LBL = ['', 'Weak', 'Fair', 'Good', 'Strong'];
      let s = 0;
      if (v.length >= 8) s++; if (/[A-Z]/.test(v)) s++; if (/[0-9]/.test(v)) s++; if (/[^\w]/.test(v)) s++;
      for (let i = 1; i <= 4; i++) { $(`pw-b${i}`).style.background = i <= s ? PAL[s] : 'rgba(255,255,255,0.08)'; }
      const lbl = $('pw-label'); lbl.textContent = LBL[s]; lbl.style.color = PAL[s] || 'var(--cream-dim)';
    });

    $('signup-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      const email = $('email').value.trim(); const pw = $('password').value; const conf = $('confirm').value; const terms = $('terms').checked;
      let ok = true;
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email); showErr('email', !emailOk); setErr('email', !emailOk); if (!emailOk) ok = false;
      const pwOk = pw.length >= 8; showErr('pw', !pwOk); setErr('password', !pwOk); if (!pwOk) ok = false;
      const confOk = pw === conf && conf !== ''; showErr('confirm', !confOk); setErr('confirm', !confOk); if (!confOk) ok = false;
      showErr('terms', !terms); if (!terms) ok = false;
      if (!ok) return;

      const btn = $('signup-btn'); btn.disabled = true; $('signup-spinner').style.display = 'inline-block';
      $('signup-icon').style.display = 'none'; $('signup-text').textContent = 'Creating account…';

      try {
        const res = await fetch('/api/v1/auth/citizen/register', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password: pw })
        });
        const data = await res.json();

        if (data.status === 'success') {
          // Store citizen id globally for the UI
          window.registeredCitizenId = data.citizenId;
          setTimeout(transitionToPhase2, 1000);
        } else {
          throw new Error(data.message || 'Registration failed');
        }
      } catch (err) {
        showErr('terms', true);
        $('err-terms').textContent = err.message;
        btn.disabled = false; $('signup-spinner').style.display = 'none';
        $('signup-icon').style.display = 'inline-block'; $('signup-text').textContent = 'Create Account & Continue';
      }
    });

    function transitionToPhase2() {
      const n1 = $('step1-node'); n1.classList.remove('active'); n1.classList.add('done');
      n1.innerHTML = '<span class="material-symbols-outlined" style="font-size:13px">check</span>';
      $('step-line').classList.add('done'); $('step2-node').classList.add('active'); $('step2-lbl').classList.add('active');
      const p1 = $('phase-signup'); p1.style.transition = 'opacity 0.35s ease'; p1.style.opacity = '0';
      setTimeout(() => {
        p1.style.display = 'none'; $('hero-panel').style.display = 'none';
        document.body.style.gridTemplateColumns = '1fr'; $('phase-dashboard').style.display = 'block';
        $('display-citizen-id').textContent = window.registeredCitizenId;
        const m = $('verification-modal'); m.style.display = 'flex';
      }, 380);
    }

    $('doc-file').addEventListener('change', function () {
      if (this.files && this.files[0]) { $('file-name-display').textContent = this.files[0].name; $('file-chosen').classList.add('show'); showErr('file', false); }
    });
    const zone = $('upload-zone');
    ['dragenter', 'dragover'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.add('drag-over'); }));
    ['dragleave', 'drop'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.remove('drag-over'); }));
    zone.addEventListener('drop', e => {
      const f = e.dataTransfer.files[0];
      if (f) { $('file-name-display').textContent = f.name; $('file-chosen').classList.add('show'); showErr('file', false); }
    });

    $('verify-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      const dt = $('doc-type').value, df = $('doc-file').files[0]; let ok = true;
      if (!dt) { showErr('doc-type', true); ok = false; } else showErr('doc-type', false);
      if (!df) { showErr('file', true); ok = false; } else showErr('file', false);
      if (!ok) return;

      const btn = $('verify-btn'); btn.disabled = true; $('verify-spinner').style.display = 'inline-block';
      $('verify-icon').style.display = 'none'; $('verify-text').textContent = 'Uploading securely…';

      try {
        const res = await fetch('/api/v1/auth/citizen/verify-document', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ docType: dt, docPath: 'uploaded_doc.png' })
        });
        if (res.ok) {
          $('verify-text').textContent = 'Analysing document…';
          setTimeout(showSuccess, 1000);
        } else {
          throw new Error('Verification failed');
        }
      } catch (err) {
        showErr('doc-type', true);
        $('err-doc-type').textContent = err.message;
        btn.disabled = false; $('verify-spinner').style.display = 'none';
        $('verify-icon').style.display = 'inline-block'; $('verify-text').textContent = 'Submit for Verification';
      }
    });

    function showSuccess() { $('modal-form-state').style.display = 'none'; $('modal-success').style.display = 'flex'; }

    async function skipVerification() {
      const skipBtn = $('skip-btn'); skipBtn.disabled = true; $('skip-text').textContent = 'Skipping...';
      try {
        await fetch('/api/v1/auth/citizen/skip-verification', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        enterDashboard();
      } catch (err) {
        skipBtn.disabled = false; $('skip-text').textContent = 'Verify Later';
      }
    }

    function enterDashboard() {
      const m = $('verification-modal'); m.style.transition = 'opacity 0.3s ease'; m.style.opacity = '0';
      document.querySelector('.dash-shell').style.filter = 'none';
      setTimeout(() => { m.style.display = 'none'; window.location.replace('/dashboard'); }, 400);
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') e.preventDefault(); });

    /* ── Real Auth Toggle & JWT Login Logic ── */
    let isLoginMode = false;
    function toggleAuthMode(e) {
      e.preventDefault();
      isLoginMode = !isLoginMode;
      $('signup-form').style.display = isLoginMode ? 'none' : 'block';
      $('signin-form').style.display = isLoginMode ? 'block' : 'none';

      document.querySelector('.form-heading').textContent = isLoginMode ? 'Welcome Back' : 'Create your account';
      document.querySelector('.form-sub').textContent = isLoginMode ? 'Authenticate to access your secure wallet.' : 'Secure access to your government digital documents.';
      $('toggle-auth-text').textContent = isLoginMode ? 'Need an account? Register here' : 'Already a member? Sign In';
    }

    $('signin-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      const citizenId = ($('login-id').value || '').trim();
      const password = ($('login-password').value || '').trim();

      if (!citizenId || !password) {
        const errEl = $('err-login');
        errEl.textContent = 'Please enter your Citizen ID and password.';
        errEl.classList.add('show');
        return;
      }

      $('signin-btn').disabled = true;
      $('signin-spinner').style.display = 'inline-block';
      $('signin-icon').style.display = 'none';
      $('signin-text').textContent = 'Verifying identity...';
      const errEl = $('err-login');
      errEl.classList.remove('show');

      try {
        const res = await fetch('/api/v1/auth/citizen/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ citizenId, password })
        });
        const data = await res.json();

        if (res.ok && data.status === 'success') {
          window.location.replace('/dashboard');
          return;
        }

        // Show server-side error message
        const msg = data.message || (Array.isArray(data.message) ? data.message.join(', ') : null) || 'Invalid Citizen ID or password.';
        errEl.textContent = msg;
        errEl.classList.add('show');
      } catch (err) {
        errEl.textContent = 'Network error — could not reach server. Please try again.';
        errEl.classList.add('show');
      } finally {
        $('signin-btn').disabled = false;
        $('signin-spinner').style.display = 'none';
        $('signin-icon').style.display = 'inline-block';
        $('signin-text').textContent = 'Authenticate & Enter Portal';
      }
    });
  </script>
</body>

</html>