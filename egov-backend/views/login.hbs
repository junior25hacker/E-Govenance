<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register & Sign-In | CitizenNode</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=DM+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    rel="stylesheet" />
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --navy: #050d1f;
      --navy-2: #0a1833;
      --navy-3: #0f2347;
      --blue-mid: #1a3a6b;
      --blue-acc: #2563b0;
      --gold: #c9a84c;
      --gold-lt: #e8c96a;
      --gold-dim: #7a5f20;
      --cream: #f2eedf;
      --cream-dim: #cdc8b4;
      --white: #ffffff;
      --border: rgba(201, 168, 76, 0.18);
      --border-b: rgba(201, 168, 76, 0.35);
      --glass: rgba(255, 255, 255, 0.05);
      --glass-b: rgba(255, 255, 255, 0.10);
      --success: #22c55e;
      --danger: #ef4444;
      --warning: #f59e0b;
      --info: #3b82f6;
      --grad-gold: linear-gradient(135deg, var(--gold-dim), var(--gold));
      --grad-gold-h: linear-gradient(135deg, var(--gold), var(--gold-lt));
      --grad-blue: linear-gradient(135deg, var(--blue-mid), var(--navy-3));
      --grad-panel: linear-gradient(160deg, var(--navy-3) 0%, var(--blue-mid) 55%, #1e4a85 100%);
      --grad-card: linear-gradient(180deg, var(--navy-2) 0%, rgba(10, 24, 51, 0.97) 100%);
    }

    html {
      scroll-behavior: smooth;
      height: 100%;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--navy);
      color: var(--cream);
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow: hidden;
    }

    .hero-panel {
      position: relative;
      background: var(--grad-panel);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 44px 48px;
      overflow: hidden;
      min-height: 100vh;
    }

    .hero-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: linear-gradient(rgba(201, 168, 76, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201, 168, 76, 0.06) 1px, transparent 1px);
      background-size: 56px 56px;
    }

    .hero-panel::after {
      content: '';
      position: absolute;
      width: 520px;
      height: 520px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37, 99, 176, 0.35) 0%, transparent 65%);
      bottom: -160px;
      right: -140px;
      pointer-events: none;
    }

    .hero-orb-top {
      position: absolute;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201, 168, 76, 0.14) 0%, transparent 65%);
      top: -80px;
      left: -60px;
      pointer-events: none;
    }

    .hero-noise {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.4;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    }

    .hero-brand {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .hero-logo-box {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(201, 168, 76, 0.25), rgba(201, 168, 76, 0.1));
      border: 1px solid var(--border-b);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      box-shadow: 0 4px 16px rgba(201, 168, 76, 0.2);
    }

    .hero-logo-box .material-symbols-outlined {
      font-size: 26px;
    }

    .hero-brand-name {
      font-family: 'Cinzel', serif;
      font-size: 18px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 0.05em;
    }

    .hero-brand-sub {
      font-size: 11px;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .hero-body {
      position: relative;
      z-index: 1;
    }

    .hero-tagline {
      font-family: 'Cinzel', serif;
      font-size: clamp(22px, 3vw, 32px);
      font-weight: 900;
      color: var(--white);
      line-height: 1.25;
      margin-bottom: 16px;
    }

    .hero-tagline span {
      background: var(--grad-gold);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-sub {
      font-size: 15px;
      color: rgba(242, 238, 223, 0.75);
      line-height: 1.7;
      max-width: 340px;
      margin-bottom: 36px;
      font-weight: 300;
    }

    .hero-features {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .hero-feature {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .feature-dot {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: var(--grad-blue);
      border: 1px solid var(--border-b);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      flex-shrink: 0;
    }

    .feature-dot .material-symbols-outlined {
      font-size: 17px;
    }

    .feature-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--white);
    }

    .feature-desc {
      font-size: 12px;
      color: rgba(205, 200, 180, 0.65);
      margin-top: 1px;
    }

    .hero-stats {
      position: relative;
      z-index: 1;
      display: flex;
      gap: 28px;
      padding-top: 28px;
      border-top: 1px solid rgba(201, 168, 76, 0.15);
    }

    .hero-stat-val {
      font-family: 'Cinzel', serif;
      font-size: 22px;
      font-weight: 700;
      background: var(--grad-gold);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-stat-lbl {
      font-size: 11px;
      color: rgba(205, 200, 180, 0.55);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 2px;
      font-family: 'JetBrains Mono', monospace;
    }

    .hero-version {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-family: 'JetBrains Mono', monospace;
      color: var(--gold);
      background: rgba(201, 168, 76, 0.1);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 4px 12px;
      margin-bottom: 20px;
    }

    .version-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
      animation: blink 2s ease infinite;
    }

    @keyframes blink {

      0%,
      100% {
        opacity: 1
      }

      50% {
        opacity: 0.3
      }
    }

    .form-panel {
      background: var(--grad-card);
      border-left: 1px solid var(--border);
      overflow-y: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 28px;
      min-height: 100vh;
      position: relative;
    }

    .form-panel::before {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37, 99, 176, 0.08) 0%, transparent 65%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .auth-card {
      width: 100%;
      max-width: 440px;
      position: relative;
      z-index: 1;
    }

    .auth-card-inner {
      background: rgba(10, 24, 51, 0.6);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 36px 36px 30px;
      backdrop-filter: blur(14px);
      box-shadow: 0 0 0 1px rgba(201, 168, 76, 0.06), 0 24px 60px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.04);
      position: relative;
      overflow: hidden;
      animation: fadeUp 0.45s ease both;
    }

    .auth-card-inner::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--grad-gold);
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .step-track {
      display: flex;
      align-items: center;
      margin-bottom: 6px;
    }

    .step-node {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      border: 2px solid var(--border);
      color: var(--cream-dim);
      background: var(--navy-3);
      flex-shrink: 0;
      transition: all 0.4s;
      font-family: 'JetBrains Mono', monospace;
    }

    .step-node.active {
      background: var(--grad-gold);
      border-color: transparent;
      color: var(--navy);
      box-shadow: 0 0 0 4px rgba(201, 168, 76, 0.15);
    }

    .step-node.done {
      background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(34, 197, 94, 0.1));
      border-color: rgba(34, 197, 94, 0.4);
      color: var(--success);
    }

    .step-line {
      flex: 1;
      height: 2px;
      background: var(--border);
      max-width: 100%;
      margin: 0 6px;
      transition: background 0.4s;
    }

    .step-line.done {
      background: var(--grad-gold);
    }

    .step-labels {
      display: flex;
      justify-content: space-between;
      margin-bottom: 26px;
    }

    .step-label {
      font-size: 10px;
      color: var(--cream-dim);
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.05em;
      flex: 1;
      text-align: center;
    }

    .step-label:first-child {
      text-align: left;
    }

    .step-label:last-child {
      text-align: right;
    }

    .step-label.active {
      color: var(--gold);
    }

    .form-heading {
      font-family: 'Cinzel', serif;
      font-size: 18px;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 4px;
    }

    .form-sub {
      font-size: 13px;
      color: var(--cream-dim);
      margin-bottom: 24px;
      font-weight: 300;
      line-height: 1.5;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 500;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 7px;
    }

    .input-wrap {
      position: relative;
    }

    .input-icon {
      position: absolute;
      left: 13px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(201, 168, 76, 0.4);
      font-size: 17px;
      pointer-events: none;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      background: rgba(5, 13, 31, 0.7);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 11px 14px 11px 42px;
      color: var(--white);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      outline: none;
      transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
    }

    .form-group input::placeholder {
      color: rgba(205, 200, 180, 0.3);
      font-weight: 300;
    }

    .form-group input:focus,
    .form-group select:focus {
      border-color: var(--border-b);
      background: rgba(10, 24, 51, 0.9);
      box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.1);
    }

    .form-group input.error {
      border-color: var(--danger);
    }

    .field-error {
      font-size: 11px;
      color: var(--danger);
      margin-top: 5px;
      display: none;
    }

    .field-error.show {
      display: block;
    }

    .pw-strength {
      margin-top: 8px;
      display: flex;
      gap: 4px;
      align-items: center;
    }

    .pw-bar {
      flex: 1;
      height: 3px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.08);
      transition: background 0.3s;
    }

    .pw-label {
      font-size: 10px;
      font-family: 'JetBrains Mono', monospace;
      color: var(--cream-dim);
      margin-left: 6px;
      min-width: 40px;
    }

    .pw-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: rgba(201, 168, 76, 0.4);
      cursor: pointer;
      display: flex;
      align-items: center;
      padding: 0;
      transition: color 0.2s;
    }

    .pw-toggle:hover {
      color: var(--gold);
    }

    .terms-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin: 18px 0;
      font-size: 13px;
      color: var(--cream-dim);
      line-height: 1.5;
    }

    .terms-row input[type="checkbox"] {
      width: 15px;
      height: 15px;
      accent-color: var(--gold);
      margin-top: 2px;
      flex-shrink: 0;
    }

    .terms-row a {
      color: var(--gold);
      text-decoration: none;
    }

    .terms-row a:hover {
      text-decoration: underline;
    }

    .btn-primary {
      width: 100%;
      padding: 13px;
      border-radius: 10px;
      background: var(--grad-gold);
      color: var(--navy);
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.25s;
      position: relative;
      letter-spacing: 0.02em;
    }

    .btn-primary:hover:not(:disabled) {
      background: var(--grad-gold-h);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(201, 168, 76, 0.32);
    }

    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .btn-ghost {
      width: 100%;
      padding: 11px;
      border-radius: 10px;
      background: transparent;
      border: 1px solid var(--border-b);
      color: var(--gold);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s;
    }

    .btn-ghost:hover {
      background: rgba(201, 168, 76, 0.08);
      box-shadow: 0 0 0 1px rgba(201, 168, 76, 0.2);
    }

    .spinner {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(5, 13, 31, 0.25);
      border-top-color: var(--navy);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: none;
      flex-shrink: 0;
    }

    .modal-spinner {
      border-color: rgba(201, 168, 76, 0.2);
      border-top-color: var(--gold);
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 20px 0;
      color: rgba(201, 168, 76, 0.3);
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .footer-links {
      margin-top: 20px;
      font-size: 13px;
      text-align: center;
      color: var(--cream-dim);
    }

    .footer-links a {
      color: var(--gold);
      text-decoration: none;
      font-weight: 600;
    }

    .footer-links a:hover {
      text-decoration: underline;
    }

    #phase-dashboard {
      display: none;
      position: relative;
      z-index: 1;
      width: 100%;
    }

    .dash-shell {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 220px 1fr;
      filter: blur(4px) brightness(0.65);
      pointer-events: none;
      user-select: none;
    }

    .dash-sidebar {
      background: rgba(10, 24, 51, 0.95);
      border-right: 1px solid var(--border);
      padding: 24px 16px;
    }

    .dash-brand {
      font-family: 'Cinzel', serif;
      font-size: 14px;
      color: var(--gold);
      margin-bottom: 28px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }

    .dash-nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 13px;
      color: var(--cream-dim);
      margin-bottom: 4px;
    }

    .dash-nav-item.active {
      background: linear-gradient(135deg, rgba(201, 168, 76, 0.18), rgba(201, 168, 76, 0.06));
      border: 1px solid rgba(201, 168, 76, 0.2);
      color: var(--gold);
    }

    .dash-nav-item .material-symbols-outlined {
      font-size: 17px;
    }

    .dash-main {
      padding: 28px;
      background: var(--navy);
    }

    .dash-main-title {
      font-family: 'Cinzel', serif;
      font-size: 22px;
      color: var(--white);
      margin-bottom: 24px;
    }

    .dash-kpi-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    .dash-kpi {
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px;
    }

    .dash-kpi-val {
      font-family: 'Cinzel', serif;
      font-size: 26px;
      color: var(--white);
      font-weight: 700;
    }

    .dash-kpi-lbl {
      font-size: 11px;
      color: var(--cream-dim);
      margin-top: 4px;
    }

    .dash-section {
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px;
      height: 160px;
    }

    #verification-modal {
      position: fixed;
      inset: 0;
      z-index: 900;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .modal-overlay {
      position: absolute;
      inset: 0;
      background: rgba(5, 13, 31, 0.88);
      backdrop-filter: blur(8px);
    }

    .modal-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 480px;
      background: var(--grad-card);
      border: 1px solid var(--border-b);
      border-radius: 24px;
      padding: 36px 36px 30px;
      box-shadow: 0 32px 100px rgba(0, 0, 0, 0.65);
      animation: modalPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      overflow: hidden;
    }

    .modal-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--grad-gold);
    }

    @keyframes modalPop {
      from {
        opacity: 0;
        transform: scale(0.88) translateY(18px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .modal-alert-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 18px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--border);
    }

    .modal-alert-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .modal-alert-icon .material-symbols-outlined {
      font-size: 22px;
      color: var(--warning);
    }

    .modal-alert-sub {
      font-size: 11px;
      color: var(--warning);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 3px;
    }

    .modal-alert-heading {
      font-family: 'Cinzel', serif;
      font-size: 15px;
      font-weight: 700;
      color: var(--white);
      line-height: 1.25;
    }

    .modal-desc {
      font-size: 13px;
      color: var(--cream-dim);
      line-height: 1.65;
      margin-bottom: 22px;
    }

    .modal-desc strong {
      color: var(--cream);
    }

    .upload-zone {
      border: 2px dashed var(--border-b);
      border-radius: 14px;
      padding: 22px;
      text-align: center;
      cursor: pointer;
      transition: all 0.25s;
      margin-top: 6px;
      position: relative;
      background: rgba(5, 13, 31, 0.4);
    }

    .upload-zone:hover,
    .upload-zone.drag-over {
      border-color: var(--gold);
      background: rgba(201, 168, 76, 0.05);
    }

    .upload-zone input[type="file"] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }

    .upload-zone-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--grad-blue);
      border: 1px solid var(--border-b);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      font-size: 22px;
      margin: 0 auto 10px;
    }

    .upload-zone-label {
      font-size: 14px;
      font-weight: 600;
      color: var(--cream);
    }

    .upload-zone-hint {
      font-size: 12px;
      color: var(--cream-dim);
      margin-top: 4px;
    }

    .upload-zone-hint span {
      color: var(--gold);
    }

    .file-chosen {
      display: none;
      align-items: center;
      gap: 10px;
      background: rgba(34, 197, 94, 0.08);
      border: 1px solid rgba(34, 197, 94, 0.25);
      border-radius: 10px;
      padding: 10px 14px;
      margin-top: 10px;
      font-size: 13px;
      color: var(--success);
    }

    .file-chosen.show {
      display: flex;
    }

    .modal-card .form-group select {
      background: rgba(5, 13, 31, 0.7);
      border: 1px solid var(--border-b);
      border-radius: 10px;
      padding: 11px 14px 11px 42px;
      color: var(--cream);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      outline: none;
      width: 100%;
      appearance: none;
      transition: all 0.25s;
      cursor: pointer;
    }

    .modal-card .form-group select:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.1);
    }

    .modal-card .form-group select option {
      background: var(--navy-2);
    }

    .trust-row {
      display: flex;
      justify-content: center;
      gap: 18px;
      margin-top: 18px;
      flex-wrap: wrap;
    }

    .trust-badge {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      color: var(--cream-dim);
      font-family: 'JetBrains Mono', monospace;
    }

    .trust-badge .material-symbols-outlined {
      font-size: 13px;
      color: var(--gold);
    }

    #modal-success {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 16px 0;
    }

    .success-ring {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: rgba(34, 197, 94, 0.1);
      border: 2px solid var(--success);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes popIn {
      from {
        opacity: 0;
        transform: scale(0.5);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .success-ring .material-symbols-outlined {
      font-size: 34px;
      color: var(--success);
    }

    #modal-success h3 {
      font-family: 'Cinzel', serif;
      font-size: 18px;
      color: var(--white);
      margin-bottom: 8px;
    }

    #modal-success p {
      font-size: 14px;
      color: var(--cream-dim);
      line-height: 1.65;
    }

    @media (max-width: 900px) {
      body {
        grid-template-columns: 1fr;
      }

      .hero-panel {
        display: none;
      }

      #phase-dashboard .dash-shell {
        grid-template-columns: 1fr;
      }

      .dash-sidebar {
        display: none;
      }
    }

    @media (max-width: 540px) {
      .form-panel {
        padding: 24px 16px;
      }

      .auth-card-inner {
        padding: 28px 22px;
      }
    }

    ::-webkit-scrollbar {
      width: 5px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: rgba(201, 168, 76, 0.2);
      border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: rgba(201, 168, 76, 0.4);
    }
  </style>
</head>

<body>

  <div class="hero-panel" id="hero-panel">
    <div class="hero-orb-top"></div>
