<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Track Requests | Emergence-Connect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #050d1f; --navy-2: #0a1833; --navy-3: #0f2347;
      --blue-mid: #1a3a6b; --blue-acc: #2563b0; --gold: #c9a84c;
      --gold-lt: #e8c96a; --gold-dim: #7a5f20; --cream: #f2eedf;
      --cream-dim: #cdc8b4; --white: #ffffff;
      --glass: rgba(255,255,255,0.05); --glass-b: rgba(255,255,255,0.10);
      --border: rgba(201,168,76,0.18); --border-b: rgba(201,168,76,0.35);
      --r: 8px; --r-lg: 16px; --r-xl: 24px;
      --success: #22c55e; --warning: #f59e0b; --danger: #ef4444; --info: #3b82f6;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', sans-serif; background: var(--navy); color: var(--cream);
      overflow-x: hidden; line-height: 1.6; display: flex; min-height: 100vh;
    }
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
    }

    /* SIDEBAR */
    .sidebar {
      width: 260px; background: rgba(5, 13, 31, 0.92); backdrop-filter: blur(20px);
      border-right: 1px solid var(--border); padding: 0; height: 100vh;
      position: fixed; top: 0; left: 0; z-index: 100; overflow-y: auto;
      display: flex; flex-direction: column;
    }
    .sidebar-header { display: flex; align-items: center; padding: 28px 20px 22px; border-bottom: 1px solid var(--border); }
    .sidebar-logo { width: 40px; height: 40px; border-radius: 10px;
      background: linear-gradient(135deg, var(--blue-mid), var(--navy-3)); border: 1px solid var(--border-b);
      display: flex; align-items: center; justify-content: center; color: var(--gold); margin-right: 12px; flex-shrink: 0;
    }
    .sidebar-brand { display: flex; flex-direction: column; }
    .sidebar-logo-text { font-family: 'Cinzel', serif; font-weight: 700; color: var(--white); font-size: 15px; line-height: 1.2; }
    .sidebar-logo-sub { font-size: 11px; color: var(--gold); letter-spacing: 0.1em; text-transform: uppercase; }
    .sidebar-nav { list-style: none; padding: 4px 12px; flex: 1; }
    .sidebar-nav li { margin-bottom: 4px; }
    .sidebar-nav a {
      display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: var(--r);
      color: var(--cream-dim); text-decoration: none; font-size: 14px; font-weight: 500;
      transition: background 0.2s, color 0.2s; position: relative;
    }
    .sidebar-nav a:hover { background: var(--glass-b); color: var(--white); }
    .sidebar-nav a.active { background: linear-gradient(135deg, rgba(201,168,76,0.18), rgba(201,168,76,0.08));
      color: var(--gold) !important; border: 1px solid rgba(201,168,76,0.25);
    }
    .sidebar-nav a.active::before { content: ''; position: absolute; left: 0; top: 20%; bottom: 20%; width: 3px;
      background: var(--gold); border-radius: 0 3px 3px 0;
    }

    /* MAIN CONTENT */
    .main-content { flex: 1; margin-left: 260px; padding: 0; display: flex; flex-direction: column; }
    .top-nav { background: rgba(5,13,31,0.85); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border);
      padding: 0 32px; height: 68px; display: flex; align-items: center; justify-content: space-between; z-index: 50;
    }
    .page-title { font-family: 'Cinzel', serif; font-size: 1.3rem; font-weight: 700; color: var(--white); }
    
    /* CONTENT AREA */
    .content-wrapper { flex: 1; padding: 32px; overflow-y: auto; position: relative; z-index: 1; }
    .page-header { margin-bottom: 32px; }
    .page-heading { font-family: 'Cinzel', serif; font-size: 2rem; color: var(--white); margin-bottom: 8px; text-transform: uppercase; }
    .page-desc { color: var(--cream-dim); font-size: 14px; }

    /* TRACK REQUESTS SPECIFIC STYLES */
    .track-section {
        background: var(--glass); border: 1px solid var(--border); border-radius: var(--r-lg);
        padding: 28px; margin-bottom: 24px;
    }
    .section-title {
        font-family: 'Cinzel', serif; font-size: 1.2rem; color: var(--white); margin-bottom: 20px;
    }

    /* Section 1: Select Request */
    .select-dropdown {
        width: 100%; background: rgba(255,255,255,0.06); border: 1px solid var(--border);
        border-radius: var(--r); padding: 12px 16px; color: var(--white);
        font-family: 'DM Sans', sans-serif; font-size: 14px; outline: none;
        cursor: pointer;
    }
    .select-dropdown option {
        background: var(--navy-2); color: var(--white);
    }
    .selected-info {
        display: flex; justify-content: space-between; margin-top: 16px; padding: 16px;
        background: rgba(255,255,255,0.03); border-radius: var(--r); border: 1px dashed var(--border-b);
    }
    .info-col { display: flex; flex-direction: column; }
    .info-label { font-size: 11px; color: var(--gold); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px; }
    .info-val { font-size: 14px; color: var(--white); font-weight: 500; }

    /* Section 2: Tracker */
    .tracker-wrapper { margin: 40px 0; position: relative; }
    .tracker-line-bg {
        position: absolute; top: 16px; left: 10%; right: 10%; height: 2px;
        background: var(--border); z-index: 0;
    }
    .tracker-line-fill {
        position: absolute; top: 16px; left: 10%; height: 2px;
        background: var(--success); z-index: 1; width: 50%; /* dynamically update this */
        transition: width 0.5s ease;
    }
    .tracker-steps {
        display: flex; justify-content: space-between; position: relative; z-index: 2;
    }
    .step {
        display: flex; flex-direction: column; align-items: center; width: 20%; gap: 12px;
    }
    .step-icon {
        width: 32px; height: 32px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: var(--navy-3); border: 2px solid var(--border);
        transition: all 0.3s; color: var(--cream-dim); font-size: 16px;
    }
    .step.completed .step-icon { background: var(--success); border-color: var(--success); color: var(--navy); }
    .step.active .step-icon { background: var(--gold); border-color: var(--gold); color: var(--navy); box-shadow: 0 0 12px rgba(201, 168, 76, 0.4); }
    .step-label { font-size: 13px; color: var(--cream-dim); font-weight: 500; text-align: center; }
    .step.completed .step-label { color: var(--success); }
    .step.active .step-label { color: var(--gold); }

    .details-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
        margin-top: 32px; border-top: 1px solid var(--border); padding-top: 24px;
    }

    /* Section 3: History */
    .timeline {
        position: relative; padding-left: 28px; margin-top: 12px;
    }
    .timeline::before {
        content: ''; position: absolute; left: 9px; top: 8px; bottom: 0; width: 2px; background: var(--border);
    }
    .timeline-item {
        position: relative; margin-bottom: 24px;
    }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-icon {
        position: absolute; left: -28px; top: 0; width: 20px; height: 20px; border-radius: 50%;
        background: var(--navy-3); border: 2px solid var(--gold);
        display: flex; align-items: center; justify-content: center; color: var(--gold);
    }
    .timeline-item.completed .timeline-icon {
        border-color: var(--success); background: var(--success); color: var(--navy);
    }
    .timeline-content {
        background: rgba(255,255,255,0.03); border: 1px solid var(--border);
        border-radius: var(--r); padding: 16px;
    }
    .timeline-title { font-size: 14px; color: var(--white); font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between; }
    .timeline-desc { font-size: 13px; color: var(--cream-dim); }
    .timeline-date { font-size: 11px; color: var(--gold-dim); }

    @media (max-width: 768px) {
      .sidebar { display: none; }
      .main-content { margin-left: 0; }
      .details-grid { grid-template-columns: 1fr; }
      .step-label { font-size: 11px; }
    }
  </style>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-logo">
        <span class="material-symbols-outlined">account_balance</span>
      </div>
      <div class="sidebar-brand">
        <div class="sidebar-logo-text">Emergence</div>
        <div class="sidebar-logo-sub">Connect</div>
      </div>
    </div>
    <ul class="sidebar-nav">
      <li><a href="/dashboard"><span class="material-symbols-outlined">dashboard</span> Dashboard</a></li>
      <li><a href="/documents"><span class="material-symbols-outlined">description</span> My Documents</a></li>
      <li><a href="/request"><span class="material-symbols-outlined">add_circle</span> New Request</a></li>
      <li><a href="/track-requests" class="active"><span class="material-symbols-outlined">track_changes</span> Track Requests</a></li>
      <li><a href="/system-activity-log">
          <span class="material-symbols-outlined">history</span>
          <span>System Activity Log</span>
        </a></li>
      <li><a href="/report"><span class="material-symbols-outlined">bug_report</span> Report Issue</a></li>
      <li><a href="/settings"><span class="material-symbols-outlined">settings</span> Settings</a></li>
      <li><a href="/help"><span class="material-symbols-outlined">help_outline</span> Help & Support</a></li>
    </ul>

    <div class="sidebar-requests-section" style="padding: 12px 20px; margin-top: auto; border-top: 1px solid var(--border);">
      <div style="font-size: 11px; color: var(--gold); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px;">My Requests</div>
      <ul id="sidebar-requests-list" style="list-style: none; padding: 0; margin: 0; font-size: 13px;">
        <!-- Dynamically populated -->
      </ul>
    </div>
  </aside>

  <main class="main-content">
    <nav class="top-nav">
      <h1 class="page-title">Track Requests</h1>
      <span class="material-symbols-outlined" style="color: var(--gold);">track_changes</span>
    </nav>

    <div class="content-wrapper">
      <div class="page-header">
        <h2 class="page-heading">TRACK REQUESTS</h2>
        <p class="page-desc">Monitor the progress of your submitted document and certificate requests.</p>
      </div>

      <!-- Dynamic Content Wrapper -->
      <div id="tracking-content" style="display: none;">
        <!-- Section 1: Request Header -->
        <div class="track-section">
          <h3 class="section-title">Request Details</h3>
          <div class="details-grid" style="margin-top: 0; border-top: none; padding-top: 0;">
              <div class="info-col">
                  <span class="info-label">Title</span>
                  <span class="info-val" id="det-title">-</span>
              </div>
              <div class="info-col">
                  <span class="info-label">Reference Number</span>
                  <span class="info-val" id="det-ref-num">-</span>
              </div>
              <div class="info-col">
                  <span class="info-label">Current Status</span>
                  <span class="info-val" id="det-status">-</span>
              </div>
          </div>
        </div>

        <!-- Section 2: Request Status Timeline -->
        <div class="track-section">
          <h3 class="section-title">Request Status</h3>
          
          <div class="tracker-wrapper">
              <div class="tracker-line-bg"></div>
              <div class="tracker-line-fill" id="tracker-progress" style="width: 0%;"></div>
              
              <div class="tracker-steps" style="justify-content: space-between;">
                  <div class="step" id="step-1" style="width: 33.3%;">
                      <div class="step-icon"><span class="material-symbols-outlined">how_to_reg</span></div>
                      <div class="step-label">Submitted</div>
                  </div>
                  <div class="step" id="step-2" style="width: 33.3%;">
                      <div class="step-icon"><span class="material-symbols-outlined">policy</span></div>
                      <div class="step-label">Under Review</div>
                  </div>
                  <div class="step" id="step-3" style="width: 33.3%;">
                      <div class="step-icon" id="step-3-icon"><span class="material-symbols-outlined">task_alt</span></div>
                      <div class="step-label" id="step-3-label">Approved / Rejected</div>
                  </div>
              </div>
          </div>
        </div>

      <!-- Section 3: Status History -->
      <div class="track-section">
        <h3 class="section-title">Status History</h3>
        <div class="timeline" id="history-timeline">
            <!-- Dynamically populated -->
        </div>
      </div>
      </div> <!-- End dynamic wrapper -->

      <!-- Empty State -->
      <div id="empty-state" style="display: none; padding: 40px; text-align: center; background: var(--glass); border: 1px solid var(--border); border-radius: var(--r-lg);">
          <span class="material-symbols-outlined" style="font-size: 48px; color: var(--border-b); margin-bottom: 16px;">search_off</span>
          <h3 style="color: var(--white); font-family: 'Cinzel', serif;">No request selected for tracking.</h3>
          <p style="color: var(--cream-dim); margin-top: 8px;">Please select a request from your pending list.</p>
          <a href="/dashboard" class="btn btn-primary" style="margin-top: 24px; display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px;">
              <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span> Return to Dashboard
          </a>
      </div>

    </div>
  </main>

  <script>
      const pathParts = window.location.pathname.split('/');
      const urlId = pathParts.pop();
      const id = (urlId && urlId !== 'tracking-request' && urlId !== 'track-requests') ? urlId : '{{requestId}}';

      async function fetchTrackingData() {
          if (!id || id === '') {
              document.getElementById('empty-state').style.display = 'block';
              return;
          }

          try {
              const res = await fetch(`/requests/${id}`);
              const result = await res.json();

              if (result.status !== 'success' || !result.data) {
                  document.getElementById('empty-state').style.display = 'block';
                  return;
              }

              const data = result.data;
              document.getElementById('tracking-content').style.display = 'block';

              // Header
              document.getElementById('det-title').innerText = data.title || 'N/A';
              document.getElementById('det-ref-num').innerText = data.requestId;
              document.getElementById('det-status').innerText = data.currentStatus;

              let progress = 0;
              let isRejected = data.currentStatus === 'REJECTED';
              if (data.currentStatus === 'PENDING') progress = 0;
              else if (data.currentStatus === 'UNDER REVIEW') progress = 50;
              else progress = 100;

              if (progress === 100) {
                  document.getElementById('det-status').style.color = isRejected ? 'var(--danger)' : 'var(--success)';
              } else {
                  document.getElementById('det-status').style.color = 'var(--warning)';
              }

              document.getElementById('tracker-progress').style.width = progress + '%';
              if (isRejected) {
                  document.getElementById('tracker-progress').style.background = 'var(--danger)';
              }

              // Update Steps
              const steps = [0, 50, 100];
              for(let i=0; i<3; i++) {
                  const el = document.getElementById('step-' + (i+1));
                  el.className = 'step';
                  let icon = i === 0 ? 'how_to_reg' : (i === 1 ? 'policy' : 'task_alt');
                  
                  if (progress > steps[i]) {
                      el.classList.add('completed');
                      icon = 'check'; 
                  } else if (progress === steps[i]) {
                      el.classList.add('active');
                  }

                  if (i === 2 && progress === 100) {
                      el.classList.add('completed');
                      if (isRejected) {
                          icon = 'cancel';
                          el.querySelector('.step-icon').style.background = 'var(--danger)';
                          el.querySelector('.step-icon').style.borderColor = 'var(--danger)';
                          document.getElementById('step-3-label').innerText = 'Rejected';
                          document.getElementById('step-3-label').style.color = 'var(--danger)';
                      } else {
                          icon = 'check';
                          document.getElementById('step-3-label').innerText = 'Approved';
                      }
                  }
                  
                  el.querySelector('.step-icon').innerHTML = '<span class="material-symbols-outlined">' + icon + '</span>';
              }

              // History Timeline
              const histContainer = document.getElementById('history-timeline');
              histContainer.innerHTML = '';
              const logs = data.logs || [];
              // Sort descending for display
              logs.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

              logs.forEach((item, index) => {
                  const isLatest = index === 0;
                  const c = document.createElement('div');
                  c.className = 'timeline-item ' + (progress === 100 && isLatest ? 'completed' : '');
                  const dateStr = new Date(item.timestamp).toLocaleString();
                  let iconStr = item.newStatus === 'REJECTED' ? 'cancel' : 'check';
                  
                  c.innerHTML = `
                      <div class="timeline-icon"><span class="material-symbols-outlined" style="font-size:12px;">${iconStr}</span></div>
                      <div class="timeline-content">
                          <div class="timeline-title">${item.newStatus} <span class="timeline-date">${dateStr}</span></div>
                          <div class="timeline-desc">System Message: ${item.description || 'Status updated'}</div>
                          <div class="timeline-date" style="margin-top: 4px;">Actor: ${item.performedBy}</div>
                      </div>
                  `;
                  histContainer.appendChild(c);
              });

          } catch (err) {
              console.error(err);
              document.getElementById('empty-state').style.display = 'block';
          }
      }

      async function fetchSidebarRequests() {
        const list = document.getElementById('sidebar-requests-list');
        if(!list) return;
        try {
          const res = await fetch('/tracking');
          const result = await res.json();
          if (result.data && result.data.length > 0) {
            list.innerHTML = '';
            result.data.forEach(req => {
              const li = document.createElement('li');
              li.style.marginBottom = '6px';
              // Hover effect via inline style events
              li.innerHTML = `<a href="/tracking-request/${req.requestId}" onmouseover="this.style.background='var(--glass-b)'; this.style.color='var(--white)';" onmouseout="this.style.background='transparent'; this.style.color='var(--cream-dim)';" style="color: var(--cream-dim); text-decoration: none; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 6px; transition: background 0.2s, color 0.2s;"><span class="material-symbols-outlined" style="font-size: 16px;">receipt_long</span> <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 170px;">${req.title}</span></a>`;
              list.appendChild(li);
            });
          } else {
            list.innerHTML = '<li style="color: var(--cream-dim); padding: 6px 8px; font-style: italic;">No requests found.</li>';
          }
        } catch(e) {
          console.error('Failed to load sidebar requests', e);
        }
      }

      window.onload = () => {
        fetchTrackingData();
        fetchSidebarRequests();
      };
  </script>
</body>
</html>
