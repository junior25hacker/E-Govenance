<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CitizenNode | Digital Identity Ecosystem</title>
  <meta name="description"
    content="A comprehensive digital certificate management and identity ecosystem bridging physical paperwork and digital identity." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    rel="stylesheet" />
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --navy: #050d1f;
      --navy-2: #0a1833;
      --navy-3: #0f2347;
      --blue-mid: #1a3a6b;
      --blue-acc: #2563b0;
      --gold: #c9a84c;
      --gold-lt: #e8c96a;
      --gold-dim: #7a5f20;
      --cream: #f2eedf;
      --cream-dim: #cdc8b4;
      --white: #ffffff;
      --glass: rgba(255, 255, 255, 0.05);
      --glass-b: rgba(255, 255, 255, 0.10);
      --border: rgba(201, 168, 76, 0.18);
      --border-b: rgba(201, 168, 76, 0.35);
      --r: 8px;
      --r-lg: 16px;
      --r-xl: 24px;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--navy);
      color: var(--cream);
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* ─── NOISE OVERLAY ─── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
    }

    /* ─── GRID BG ─── */
    .grid-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      background-image:
        linear-gradient(rgba(201, 168, 76, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201, 168, 76, 0.04) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    /* ─── NAV ─── */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
      height: 68px;
      background: rgba(5, 13, 31, 0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      transition: background 0.3s;
    }

    nav.scrolled {
      background: rgba(5, 13, 31, 0.97);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .nav-logo-icon {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: linear-gradient(135deg, var(--blue-mid), var(--navy-3));
      border: 1px solid var(--border-b);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
    }

    .nav-logo-text {
      font-family: 'Cinzel', serif;
      font-size: 15px;
      font-weight: 700;
      color: var(--cream);
      letter-spacing: 0.05em;
    }

    .nav-logo-sub {
      font-size: 10px;
      color: var(--gold);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      font-weight: 300;
    }

    .nav-links {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .nav-links a {
      color: var(--cream-dim);
      font-size: 13.5px;
      font-weight: 400;
      text-decoration: none;
      padding: 6px 14px;
      border-radius: 6px;
      transition: color 0.2s, background 0.2s;
    }

    .nav-links a:hover {
      color: var(--white);
      background: var(--glass-b);
    }

    .nav-cta {
      background: linear-gradient(135deg, var(--gold-dim), var(--gold));
      color: var(--navy) !important;
      font-weight: 600 !important;
      border-radius: 6px !important;
      padding: 8px 20px !important;
    }

    .nav-cta:hover {
      background: linear-gradient(135deg, var(--gold), var(--gold-lt)) !important;
    }

    .nav-hamburger {
      display: none;
      cursor: pointer;
      color: var(--cream);
    }

    .mobile-menu {
      display: none;
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      background: var(--navy-2);
      padding: 20px;
      flex-direction: column;
      gap: 4px;
      border-bottom: 1px solid var(--border);
      z-index: 99;
    }

    .mobile-menu.open {
      display: flex;
    }

    .mobile-menu a {
      color: var(--cream-dim);
      text-decoration: none;
      padding: 10px 16px;
      border-radius: 6px;
      font-size: 14px;
    }

    .mobile-menu a:hover {
      background: var(--glass-b);
      color: var(--white);
    }

    /* ─── HERO ─── */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 120px 24px 80px;
      overflow: hidden;
    }

    .hero-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }

    .hero-orb-1 {
      width: 600px;
      height: 600px;
      top: -100px;
      left: -150px;
      background: radial-gradient(circle, rgba(37, 99, 176, 0.25), transparent 70%);
    }

    .hero-orb-2 {
      width: 500px;
      height: 500px;
      bottom: -80px;
      right: -100px;
      background: radial-gradient(circle, rgba(201, 168, 76, 0.15), transparent 70%);
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 18px;
      border-radius: 999px;
      background: rgba(201, 168, 76, 0.1);
      border: 1px solid var(--border-b);
      color: var(--gold);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 28px;
      animation: fadeDown 0.8s ease both;
    }

    .hero-badge .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
      animation: pulse 2s ease infinite;
    }

    .hero-title {
      font-family: 'Cinzel', serif;
      font-weight: 900;
      font-size: clamp(2.4rem, 6vw, 5rem);
      line-height: 1.08;
      letter-spacing: -0.01em;
      max-width: 860px;
      margin-bottom: 24px;
      animation: fadeUp 0.9s 0.15s ease both;
    }

    .hero-title .accent {
      color: var(--gold);
    }

    .hero-title .line-block {
      display: block;
    }

    .hero-sub {
      font-size: clamp(1rem, 2vw, 1.2rem);
      font-weight: 300;
      color: var(--cream-dim);
      max-width: 620px;
      margin-bottom: 48px;
      animation: fadeUp 0.9s 0.3s ease both;
    }

    .hero-search-wrap {
      width: 100%;
      max-width: 580px;
      display: flex;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border-b);
      background: rgba(10, 24, 51, 0.7);
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      animation: fadeUp 0.9s 0.45s ease both;
      margin-bottom: 52px;
    }

    .hero-search-wrap .ms {
      padding: 0 16px;
      color: var(--gold);
      font-size: 22px;
      display: flex;
      align-items: center;
    }

    .hero-search-wrap input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: var(--white);
      font-family: 'DM Sans', sans-serif;
      font-size: 15px;
      padding: 16px 8px;
    }

    .hero-search-wrap input::placeholder {
      color: rgba(205, 200, 180, 0.4);
    }

    .hero-search-wrap button {
      background: linear-gradient(135deg, var(--gold-dim), var(--gold));
      border: none;
      color: var(--navy);
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 14px;
      padding: 0 28px;
      cursor: pointer;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: opacity 0.2s;
    }

    .hero-search-wrap button:hover {
      opacity: 0.88;
    }

    .hero-stats {
      display: flex;
      gap: 48px;
      justify-content: center;
      flex-wrap: wrap;
      animation: fadeUp 0.9s 0.6s ease both;
    }

    .stat {
      text-align: center;
    }

    .stat-num {
      font-family: 'Cinzel', serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--gold);
      line-height: 1;
    }

    .stat-label {
      font-size: 12px;
      color: var(--cream-dim);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-top: 4px;
    }

    /* ─── SECTION SHARED ─── */
    section {
      position: relative;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 32px;
    }

    .section-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 12px;
    }

    .section-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.7rem, 3.5vw, 2.6rem);
      font-weight: 700;
      line-height: 1.15;
      color: var(--white);
      margin-bottom: 16px;
    }

    .section-sub {
      font-size: 1.05rem;
      color: var(--cream-dim);
      font-weight: 300;
      max-width: 560px;
    }

    /* ─── SERVICES ─── */
    .services {
      padding: 100px 0;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-top: 56px;
    }

    .service-card {
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 32px 28px;
      cursor: pointer;
      transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
      position: relative;
      overflow: hidden;
      text-decoration: none;
      display: block;
    }

    .service-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(201, 168, 76, 0.07), transparent);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .service-card:hover {
      transform: translateY(-6px);
      border-color: var(--border-b);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    }

    .service-card:hover::before {
      opacity: 1;
    }

    .card-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      font-size: 26px;
      transition: transform 0.3s;
    }

    .service-card:hover .card-icon {
      transform: scale(1.1) rotate(-3deg);
    }

    .card-icon.civil {
      background: rgba(37, 99, 176, 0.2);
      color: #60a5fa;
    }

    .card-icon.urban {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
    }

    .card-icon.revenue {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
    }

    .card-icon.feedback {
      background: rgba(168, 85, 247, 0.15);
      color: #c084fc;
    }

    .card-title {
      font-family: 'Cinzel', serif;
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 10px;
    }

    .card-desc {
      font-size: 13.5px;
      color: var(--cream-dim);
      line-height: 1.65;
    }

    .card-arrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--gold);
      font-size: 12.5px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-top: 20px;
      transition: gap 0.2s;
    }

    .service-card:hover .card-arrow {
      gap: 10px;
    }

    /* ─── PROCESS ─── */
    .process {
      padding: 100px 0;
      background: linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 100%);
    }

    .process-header {
      margin-bottom: 60px;
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0;
      position: relative;
    }

    .process-grid::before {
      content: '';
      position: absolute;
      top: 40px;
      left: 10%;
      right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border-b), transparent);
    }

    .process-step {
      text-align: center;
      padding: 32px 20px;
      position: relative;
    }

    .step-num {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      margin: 0 auto 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--navy-3), var(--blue-mid));
      border: 1px solid var(--border-b);
      color: var(--gold);
      font-family: 'Cinzel', serif;
      font-size: 1.3rem;
      font-weight: 700;
      position: relative;
      z-index: 1;
      transition: transform 0.3s;
    }

    .process-step:hover .step-num {
      transform: scale(1.1);
    }

    .step-icon {
      font-size: 28px;
    }

    .step-title {
      font-family: 'Cinzel', serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 10px;
    }

    .step-desc {
      font-size: 13px;
      color: var(--cream-dim);
      line-height: 1.6;
    }

    /* ─── IDENTITY CTA ─── */
    .identity-cta {
      padding: 100px 0;
      background: linear-gradient(135deg, var(--navy-3) 0%, var(--blue-mid) 60%, var(--navy-2) 100%);
      position: relative;
      overflow: hidden;
    }

    .identity-cta::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(201, 168, 76, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201, 168, 76, 0.05) 1px, transparent 1px);
      background-size: 48px 48px;
    }

    .cta-inner {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 48px;
      flex-wrap: wrap;
    }

    .cta-text {
      flex: 1;
      min-width: 280px;
    }

    .cta-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.8rem, 3.5vw, 2.8rem);
      font-weight: 700;
      color: var(--white);
      margin-bottom: 16px;
      line-height: 1.15;
    }

    .cta-desc {
      font-size: 1rem;
      color: rgba(242, 238, 223, 0.75);
      font-weight: 300;
      margin-bottom: 32px;
      max-width: 500px;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--gold-dim), var(--gold));
      color: var(--navy);
      font-family: 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 15px;
      padding: 14px 32px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      letter-spacing: 0.02em;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 20px rgba(201, 168, 76, 0.3);
    }

    .cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(201, 168, 76, 0.45);
    }

    .cta-visual {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .id-card {
      width: 200px;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-b);
      border-radius: 16px;
      padding: 28px 24px;
      text-align: center;
      animation: float 4s ease-in-out infinite;
    }

    .id-card .ms {
      font-size: 48px;
      color: var(--gold);
    }

    .id-card-line {
      height: 3px;
      border-radius: 99px;
      background: rgba(201, 168, 76, 0.3);
      margin: 12px auto 8px;
    }

    .id-card-line.w1 {
      width: 80%;
    }

    .id-card-line.w2 {
      width: 60%;
      background: rgba(201, 168, 76, 0.15);
    }

    .id-card-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--gold);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-top: 12px;
    }

    /* ─── BENEFITS ─── */
    .benefits {
      padding: 100px 0;
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 24px;
      margin-top: 56px;
    }

    .benefit-card {
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 32px 24px;
      text-align: center;
      transition: border-color 0.3s, transform 0.3s;
    }

    .benefit-card:hover {
      border-color: var(--border-b);
      transform: translateY(-4px);
    }

    .benefit-icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, var(--navy-3), var(--blue-mid));
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-b);
      color: var(--gold);
      font-size: 28px;
    }

    .benefit-title {
      font-family: 'Cinzel', serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 10px;
    }

    .benefit-desc {
      font-size: 13px;
      color: var(--cream-dim);
      line-height: 1.65;
    }

    /* ─── SECURITY ─── */
    .security {
      padding: 100px 0;
      background: var(--navy-2);
      position: relative;
      overflow: hidden;
    }

    .security-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: center;
      margin-top: 0;
    }

    .security-items {
      margin-top: 40px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .security-item {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 20px;
      border-radius: var(--r);
      border: 1px solid var(--border);
      background: var(--glass);
      transition: border-color 0.3s;
    }

    .security-item:hover {
      border-color: var(--border-b);
    }

    .sec-icon {
      color: var(--gold);
      font-size: 24px;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .sec-title {
      font-weight: 600;
      color: var(--white);
      font-size: 14.5px;
      margin-bottom: 4px;
    }

    .sec-desc {
      font-size: 13px;
      color: var(--cream-dim);
      line-height: 1.6;
    }

    .security-visual {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .shield-wrap {
      position: relative;
      width: 280px;
      height: 280px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .shield-ring {
      position: absolute;
      border-radius: 50%;
      border: 1px solid;
      animation: spin linear infinite;
    }

    .ring1 {
      width: 100%;
      height: 100%;
      border-color: rgba(201, 168, 76, 0.15);
      animation-duration: 20s;
    }

    .ring2 {
      width: 75%;
      height: 75%;
      border-color: rgba(201, 168, 76, 0.22);
      animation-duration: 14s;
      animation-direction: reverse;
    }

    .ring3 {
      width: 50%;
      height: 50%;
      border-color: rgba(201, 168, 76, 0.32);
      animation-duration: 9s;
    }

    .shield-core {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      z-index: 1;
      background: linear-gradient(135deg, var(--blue-mid), var(--navy-3));
      border: 1px solid var(--border-b);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      font-size: 52px;
      box-shadow: 0 0 40px rgba(201, 168, 76, 0.2);
    }

    /* ─── FOOTER ─── */
    footer {
      background: var(--navy);
      border-top: 1px solid var(--border);
      padding: 60px 32px 32px;
    }

    .footer-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 48px;
    }

    .footer-brand .nav-logo-text {
      font-size: 18px;
    }

    .footer-tagline {
      font-size: 13px;
      color: var(--cream-dim);
      margin-top: 12px;
