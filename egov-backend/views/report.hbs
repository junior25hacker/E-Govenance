<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Report Issue | Emergence-Connect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #050d1f; --navy-2: #0a1833; --navy-3: #0f2347;
      --blue-mid: #1a3a6b; --blue-acc: #2563b0; --gold: #c9a84c;
      --gold-lt: #e8c96a; --gold-dim: #7a5f20; --cream: #f2eedf;
      --cream-dim: #cdc8b4; --white: #ffffff;
      --glass: rgba(255,255,255,0.05); --glass-b: rgba(255,255,255,0.10);
      --border: rgba(201,168,76,0.18); --border-b: rgba(201,168,76,0.35);
      --r: 8px; --r-lg: 16px; --r-xl: 24px;
      --success: #22c55e; --warning: #f59e0b; --danger: #ef4444; --info: #3b82f6;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', sans-serif; background: var(--navy); color: var(--cream);
      overflow-x: hidden; line-height: 1.6; display: flex; min-height: 100vh;
    }
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
    }

    /* SIDEBAR */
    .sidebar {
      width: 260px; background: rgba(5, 13, 31, 0.92); backdrop-filter: blur(20px);
      border-right: 1px solid var(--border); padding: 0; height: 100vh;
      position: fixed; top: 0; left: 0; z-index: 100; overflow-y: auto;
      display: flex; flex-direction: column;
    }
    .sidebar-header { display: flex; align-items: center; padding: 28px 20px 22px; border-bottom: 1px solid var(--border); }
    .sidebar-logo { width: 40px; height: 40px; border-radius: 10px;
      background: linear-gradient(135deg, var(--blue-mid), var(--navy-3)); border: 1px solid var(--border-b);
      display: flex; align-items: center; justify-content: center; color: var(--gold); margin-right: 12px; flex-shrink: 0;
    }
    .sidebar-brand { display: flex; flex-direction: column; }
    .sidebar-logo-text { font-family: 'Cinzel', serif; font-weight: 700; color: var(--white); font-size: 15px; line-height: 1.2; }
    .sidebar-logo-sub { font-size: 11px; color: var(--gold); letter-spacing: 0.1em; text-transform: uppercase; }
    .sidebar-nav { list-style: none; padding: 4px 12px; flex: 1; }
    .sidebar-nav li { margin-bottom: 4px; }
    .sidebar-nav a {
      display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: var(--r);
      color: var(--cream-dim); text-decoration: none; font-size: 14px; font-weight: 500;
      transition: background 0.2s, color 0.2s; position: relative;
    }
    .sidebar-nav a:hover { background: var(--glass-b); color: var(--white); }
    .sidebar-nav a.active { background: linear-gradient(135deg, rgba(201,168,76,0.18), rgba(201,168,76,0.08));
      color: var(--gold) !important; border: 1px solid rgba(201,168,76,0.25);
    }
    .sidebar-nav a.active::before { content: ''; position: absolute; left: 0; top: 20%; bottom: 20%; width: 3px;
      background: var(--gold); border-radius: 0 3px 3px 0;
    }

    /* MAIN CONTENT */
    .main-content { flex: 1; margin-left: 260px; padding: 0; display: flex; flex-direction: column; }
    .top-nav { background: rgba(5,13,31,0.85); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border);
      padding: 0 32px; height: 68px; display: flex; align-items: center; justify-content: space-between; z-index: 50;
    }
    .page-title { font-family: 'Cinzel', serif; font-size: 1.3rem; font-weight: 700; color: var(--white); }
    
    /* CONTENT AREA */
    .content-wrapper { flex: 1; padding: 32px; overflow-y: auto; position: relative; z-index: 1; }
    .page-header { margin-bottom: 32px; }
    .page-heading { font-family: 'Cinzel', serif; font-size: 2rem; color: var(--white); margin-bottom: 8px; }
    .page-desc { color: var(--cream-dim); font-size: 14px; }

    /* FORM SECTION */
    .form-section {
      display: grid; grid-template-columns: 1fr 1fr; gap: 32px; max-width: 1000px;
    }

    .form-card {
      background: var(--glass); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 28px;
    }

    .form-card h3 {
      font-family: 'Cinzel', serif; font-size: 1.1rem; color: var(--white); margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block; font-family: 'JetBrains Mono', monospace; font-size: 11px;
      color: var(--gold); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 8px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%; background: rgba(255,255,255,0.06); border: 1px solid var(--border);
      border-radius: var(--r); padding: 10px 12px; color: var(--white);
      font-family: 'DM Sans', sans-serif; font-size: 14px; outline: none;
      transition: border-color 0.2s;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--border-b); background: rgba(255,255,255,0.08);
    }

    .form-group input::placeholder {
      color: rgba(205,200,180,0.4);
    }

    .form-group textarea {
      resize: vertical; min-height: 120px;
    }

    .form-row {
      display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    }

    .form-row .form-group {
      margin-bottom: 20px;
    }

    /* BUTTON */
    .btn-submit {
      background: linear-gradient(135deg, var(--gold-dim), var(--gold)); color: var(--navy);
      border: none; padding: 12px 24px; border-radius: var(--r-lg); cursor: pointer;
      font-weight: 600; font-size: 14px; transition: transform 0.2s;
      width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;
    }

    .btn-submit:hover { transform: translateY(-2px); }

    /* RECENT REPORTS */
    .reports-list {
      display: flex; flex-direction: column; gap: 12px;
    }

    .report-item {
      background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 16px; display: flex; justify-content: space-between; align-items: center;
    }

    .report-info h4 { color: var(--white); font-size: 14px; margin-bottom: 4px; }
    .report-info p { color: var(--cream-dim); font-size: 12px; }

    .report-status {
      padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.05em;
    }

    .report-status.open { background: rgba(59,130,246,0.15); color: #3b82f6; }
    .report-status.in-progress { background: rgba(245,158,11,0.15); color: #f59e0b; }
    .report-status.resolved { background: rgba(34,197,94,0.15); color: #22c55e; }
    .report-status.closed { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.6); }

    @media (max-width: 768px) {
      .sidebar { display: none; }
      .main-content { margin-left: 0; }
      .form-section { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-logo">
        <span class="material-symbols-outlined">account_balance</span>
      </div>
      <div class="sidebar-brand">
        <div class="sidebar-logo-text">Emergence</div>
        <div class="sidebar-logo-sub">Connect</div>
      </div>
    </div>
    <ul class="sidebar-nav">
      <li><a href="/dashboard"><span class="material-symbols-outlined">dashboard</span> Dashboard</a></li>
      <li><a href="/documents"><span class="material-symbols-outlined">description</span> My Documents</a></li>
      <li><a href="/request"><span class="material-symbols-outlined">add_circle</span> New Request</a></li>
      <li><a href="/track-requests"><span class="material-symbols-outlined">track_changes</span> Track Requests</a></li>
      <li><a href="/system-activity-log">
          <span class="material-symbols-outlined">history</span>
          <span>System Activity Log</span>
        </a></li>
      <li><a href="/report" class="active"><span class="material-symbols-outlined">bug_report</span> Report Issue</a></li>
      <li><a href="/settings"><span class="material-symbols-outlined">settings</span> Settings</a></li>
      <li><a href="/help"><span class="material-symbols-outlined">help_outline</span> Help & Support</a></li>
    
    <div class="sidebar-requests-section" style="padding: 12px 20px; margin-top: auto; border-top: 1px solid var(--border);">
      <div style="font-size: 11px; color: var(--gold); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px;">My Requests</div>
      <ul id="sidebar-requests-list" style="list-style: none; padding: 0; margin: 0; font-size: 13px;">
        <!-- Dynamically populated -->
      </ul>
    </div>
</ul>
  </aside>

  <main class="main-content">
    <nav class="top-nav">
      <h1 class="page-title">Report Issue</h1>
      <span class="material-symbols-outlined" style="color: var(--gold);">bug_report</span>
    </nav>

    <div class="content-wrapper">
      <div class="page-header">
        <h2 class="page-heading">Report a Problem</h2>
        <p class="page-desc">Help us improve municipal services by reporting infrastructure issues, defects, or concerns in your area.</p>
      </div>

      <div class="form-section">
        <div class="form-card">
          <h3>New Issue Report</h3>
          <form id="report-form" onsubmit="handleSubmit(event)">
            <div class="form-row">
              <div class="form-group">
                <label for="category">Issue Category</label>
                <select id="category" required>
                  <option value="">Select category…</option>
                  <option value="road">Road & Pavement</option>
                  <option value="waste">Waste Management</option>
                  <option value="water">Water & Sanitation</option>
                  <option value="electricity">Electricity</option>
                  <option value="security">Public Safety</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="priority">Priority Level</label>
                <select id="priority" required>
                  <option value="">Select priority…</option>
                  <option value="low">Low</option>
                  <option value="medium">Medium</option>
                  <option value="high">High</option>
                  <option value="urgent">Urgent</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="location">Location / Address</label>
              <input type="text" id="location" placeholder="Street name, area, or landmark…" required />
            </div>

            <div class="form-group">
              <label for="description">Detailed Description</label>
              <textarea id="description" placeholder="Describe the issue in detail. What happened? When did you notice it?" required></textarea>
            </div>

            <div class="form-group">
              <label for="contact">Contact Phone (Optional)</label>
              <input type="tel" id="contact" placeholder="+1 (800) 555-0123" />
            </div>

            <button type="submit" class="btn-submit">
              <span class="material-symbols-outlined">send</span>
              Submit Report
            </button>
          </form>
        </div>

        <div class="form-card">
          <h3>Your Recent Reports</h3>
          <div class="reports-list" id="reports-container">
            <p style="color: var(--cream-dim); font-size: 13px; text-align: center;">Loading reports...</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Sync token from server cookie to localStorage if present
    const serverToken = '{{token}}';
    if (serverToken) {
      localStorage.setItem('egov_token', serverToken);
    }
    const serverCitizenId = '{{user.citizenId}}';
    if (serverCitizenId) {
      localStorage.setItem('egov_citizenId', serverCitizenId);
    }

    document.addEventListener('DOMContentLoaded', fetchReports);

    async function fetchReports() {
      const container = document.getElementById('reports-container');
      const token = localStorage.getItem('egov_token');
      if (!token) {
        container.innerHTML = '<p style="color: var(--cream-dim); font-size: 13px; text-align: center;">Please sign in to view your reports.</p>';
        return;
      }

      try {
        const res = await fetch('/api/v1/documents/reports', {
          headers: { Authorization: `Bearer ${token}` }
        });
        const json = await res.json();
        if (!res.ok) {
          container.innerHTML = '<p style="color: var(--danger); font-size: 13px; text-align: center;">Failed to load reports.</p>';
          return;
        }

        const reports = json.data || [];
        if (reports.length === 0) {
          container.innerHTML = '<p style="color: var(--cream-dim); font-size: 13px; text-align: center;">You have not submitted any reports yet.</p>';
          return;
        }

        const categoryMap = {
          road: 'Road & Pavement',
          waste: 'Waste Management',
          water: 'Water & Sanitation',
          electricity: 'Electricity',
          security: 'Public Safety',
          other: 'Other'
        };

        container.innerHTML = reports.map(rpt => {
          const dateStr = new Date(rpt.createdAt).toLocaleDateString(undefined, {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });
          const categoryLabel = categoryMap[rpt.category] || rpt.category || 'Other';
          const statusLower = (rpt.status || 'open').toLowerCase().replace('_', '-');
          
          let statusLabel = rpt.status || 'OPEN';
          if (rpt.status === 'IN_PROGRESS') statusLabel = 'In Progress';
          else if (rpt.status === 'RESOLVED') statusLabel = 'Resolved';
          else if (rpt.status === 'OPEN') statusLabel = 'Open';
          else if (rpt.status === 'CLOSED') statusLabel = 'Closed';

          const refText = rpt.referenceId ? ` (${rpt.referenceId})` : '';

          return `
            <div class="report-item" style="flex-direction: column; align-items: flex-start; gap: 8px;">
              <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                <h4 style="color: var(--white); font-size: 14px;">${categoryLabel}${refText}</h4>
                <span class="report-status ${statusLower}">${statusLabel}</span>
              </div>
              <p style="font-size: 13px; color: var(--cream); opacity: 0.85; margin: 2px 0;">${rpt.description}</p>
              <div style="display: flex; justify-content: space-between; width: 100%; font-size: 11px; color: var(--cream-dim);">
                <span>Location: ${rpt.location}</span>
                <span>${dateStr}</span>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        console.error('Error fetching reports:', err);
        container.innerHTML = '<p style="color: var(--danger); font-size: 13px; text-align: center;">Error loading reports.</p>';
      }
    }

    async function handleSubmit(event) {
      event.preventDefault();
      const category = document.getElementById('category').value;
      const priority = document.getElementById('priority').value;
      const location = document.getElementById('location').value;
      const description = document.getElementById('description').value;
      const phone = document.getElementById('contact').value;

      if (!category || !location || !description) {
        alert('Please fill in all required fields.');
        return;
      }

      const token = localStorage.getItem('egov_token');
      if (!token) {
        alert('Please sign in to submit reports.');
        window.location.href = '/login';
        return;
      }

      try {
        const res = await fetch('/api/v1/documents/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ category, priority, location, description, phone }),
        });

        const data = await res.json();
        if (!res.ok) {
          alert(data.message || 'Could not submit report');
          return;
        }

        const form = document.getElementById('report-form');
        form.innerHTML = `
          <div style="text-align: center; padding: 20px; background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); border-radius: 12px; color: #22c55e;">
            <span class="material-symbols-outlined" style="font-size: 48px; display: block; margin-bottom: 12px;">check_circle</span>
            <h3 style="margin-bottom: 8px;">Report Submitted Successfully</h3>
            <p style="font-size: 14px; color: var(--cream-dim); margin-bottom: 16px;">Your issue has been logged. A reference number has been generated for tracking.</p>
            <p style="font-size: 13px; color: var(--gold); font-weight: 600; margin-bottom: 16px;">Reference: ${data.data?.referenceId || 'RPT-2026-XXXXX'}</p>
            <button type="button" style="background: var(--gold); color: var(--navy); border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-weight: 600;" onclick="location.reload();">Back to Form</button>
          </div>
        `;
        fetchReports(); // Refresh the list immediately
      } catch (err) {
        console.error('Report submit error', err);
        alert('Network error — could not submit report');
      }
    }
  </script>

<script>
  async function fetchSidebarRequests() {
    const list = document.getElementById('sidebar-requests-list');
    if(!list) return;
    try {
      const res = await fetch('/tracking');
      const result = await res.json();
      if (result.data && result.data.length > 0) {
        list.innerHTML = '';
        result.data.forEach(req => {
          const li = document.createElement('li');
          li.style.marginBottom = '6px';
          li.innerHTML = `<a href="/tracking-request/${req.requestId}" onmouseover="this.style.background='var(--glass-b)'; this.style.color='var(--white)';" onmouseout="this.style.background='transparent'; this.style.color='var(--cream-dim)';" style="color: var(--cream-dim); text-decoration: none; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 6px; transition: background 0.2s, color 0.2s;"><span class="material-symbols-outlined" style="font-size: 16px;">receipt_long</span> <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 170px;">${req.title}</span></a>`;
          list.appendChild(li);
        });
      } else {
        list.innerHTML = '<li style="color: var(--cream-dim); padding: 6px 8px; font-style: italic;">No requests found.</li>';
      }
    } catch(e) {
      console.error('Failed to load sidebar requests', e);
    }
  }
  document.addEventListener('DOMContentLoaded', fetchSidebarRequests);
</script>
</body>
</html>
